@model StockAdjustmentViewModel
@{ ViewData["Title"] = "Stock adjustment"; }
<div class="page-heading"><div><p class="eyebrow">INVENTORY CONTROL</p><h1>Adjust branch stock</h1><p class="muted">Adjustments are validated against negative stock and written to JSON storage.</p></div></div>
<section class="panel form-panel narrow-panel"><form asp-action="Adjust" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div><label asp-for="Sku"></label><input asp-for="Sku" placeholder="APX-001"/><span asp-validation-for="Sku" class="validation"></span></div><div><label asp-for="Delta">Quantity change (+/-)</label><input asp-for="Delta" type="number" min="-10000" max="10000"/><span asp-validation-for="Delta" class="validation"></span></div><div class="span-two"><label asp-for="Reason"></label><input asp-for="Reason" maxlength="250"/><span asp-validation-for="Reason" class="validation"></span></div></div><button class="button button-primary" type="submit">Save adjustment</button></form></section>
