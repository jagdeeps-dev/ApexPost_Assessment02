@model StaffEditViewModel
@{ ViewData["Title"] = Model.Id is null ? "Add staff" : "Edit staff"; }
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>@ViewData["Title"]</h1></div></div>
<section class="panel form-panel narrow-panel"><form asp-action="@(Model.Id is null ? "Create" : "Edit")" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div><label asp-for="Name"></label><input asp-for="Name"/><span asp-validation-for="Name" class="validation"></span></div><div><label asp-for="Email"></label><input asp-for="Email" autocomplete="off"/><span asp-validation-for="Email" class="validation"></span></div><div><label asp-for="Role"></label><select asp-for="Role" asp-items="Html.GetEnumSelectList<StaffRole>()"></select></div><div><label asp-for="HomeBranchCode"></label><input asp-for="HomeBranchCode"/><span asp-validation-for="HomeBranchCode" class="validation"></span></div><div class="span-two"><label asp-for="InitialPassword">@(Model.Id is null ? "Initial password (minimum 12 characters)" : "New password (leave blank to keep current)")</label><input asp-for="InitialPassword" type="password" autocomplete="new-password"/><span asp-validation-for="InitialPassword" class="validation"></span></div></div><button class="button button-primary" type="submit">Save staff</button> <a class="button button-quiet" asp-action="Index">Cancel</a></form></section>
