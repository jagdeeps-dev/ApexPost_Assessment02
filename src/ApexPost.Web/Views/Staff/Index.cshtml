@model IReadOnlyList<Staff>
@{ ViewData["Title"] = "Staff management"; }
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Staff management</h1><p class="muted">Provision accounts, assign roles and deactivate staff securely.</p></div><a class="button button-primary" asp-action="Create">＋ Add staff</a></div>
<section class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Home branch</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Name</td><td>@item.Email</td><td>@item.Role</td><td>@item.HomeBranchCode</td><td>@item.Status</td><td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> @if (item.Status == StaffStatus.Active) { <form asp-action="Deactivate" method="post" class="inline-form"><input type="hidden" name="id" value="@item.Id"/><button class="text-button" type="submit">Deactivate</button></form> }</td></tr> }</tbody></table></div></section>
