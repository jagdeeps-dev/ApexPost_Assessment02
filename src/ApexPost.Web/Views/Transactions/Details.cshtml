@model CounterTransaction
@{ ViewData["Title"] = "Transaction details"; }
<div class="page-heading"><div><p class="eyebrow">COUNTER TRANSACTION</p><h1>Transaction <code>@Model.Id[..8]</code></h1><p class="muted">Branch @Model.BranchCode · Counter @Model.CounterId · @Model.Status</p></div><a class="button button-quiet" asp-action="Index">← All transactions</a></div>
<div class="content-grid"><section class="panel"><h2>Basket lines</h2>@if (Model.Lines.Count == 0) { <p class="muted">No lines yet. Add retail products below.</p> } else { <div class="table-scroll"><table><thead><tr><th>Description</th><th>Qty</th><th class="numeric">Unit</th><th class="numeric">Tax</th></tr></thead><tbody>@foreach (var line in Model.Lines) { <tr><td>@line.Description</td><td>@line.Quantity</td><td class="numeric">₹@line.UnitPrice.ToString("N2")</td><td class="numeric">@((line.TaxRate * 100).ToString("N0"))%</td></tr> }</tbody></table></div> }</section>
<section class="panel totals-panel"><h2>Totals</h2><div class="total-row"><span>Subtotal</span><strong>₹@Model.Subtotal.ToString("N2")</strong></div><div class="total-row"><span>Tax</span><strong>₹@Model.Tax.ToString("N2")</strong></div><div class="total-row total-final"><span>Total</span><strong>₹@Model.Total.ToString("N2")</strong></div><p class="muted">Payment: @(Model.PaymentMethod?.ToString() ?? "Not paid")</p>
@if (Model.Status == TransactionStatus.Open) { <form asp-action="Complete" method="post"><input type="hidden" name="TransactionId" value="@Model.Id" /><label>Payment method</label><select name="PaymentMethod"><option>Cash</option><option>Card</option><option>Upi</option><option>MoneyOrder</option></select><button class="button button-primary full" type="submit">Take payment</button></form> }
@if (Model.Status == TransactionStatus.Paid && (User.IsInRole("BranchManager") || User.IsInRole("Administrator"))) { <form asp-action="Void" method="post" class="form-divider"><input type="hidden" name="TransactionId" value="@Model.Id" /><label for="Reason">Void reason</label><input id="Reason" name="Reason" minlength="5" maxlength="500" required /><button class="button button-danger full" type="submit">Void transaction</button></form><form asp-action="Refund" method="post" class="form-divider"><input type="hidden" name="TransactionId" value="@Model.Id" /><label for="RefundReason">Refund reason</label><input id="RefundReason" name="Reason" minlength="5" maxlength="500" required /><button class="button button-danger full" type="submit">Refund transaction</button></form> }
</section></div>
@if (Model.Status == TransactionStatus.Open) { <section class="panel form-panel"><p class="eyebrow">ADD TO BASKET</p><h2>Add shipping service</h2><form asp-controller="Shipping" asp-action="AddToTransaction" method="post"><input type="hidden" name="TransactionId" value="@Model.Id"/><div class="form-grid"><div><label for="Kind">Shipment type</label><select name="Kind"><option>Parcel</option><option>Letter</option></select></div><div><label for="WeightKg">Weight (kg)</label><input name="WeightKg" type="number" step="0.01" min="0.01" max="100" value="1" required/></div><div><label for="DestinationZone">Destination zone</label><select name="DestinationZone">@for (var i = 1; i <= 10; i++) { var zone = $"ZONE-{i:00}"; <option value="@zone">@zone</option> }</select></div><div><label for="ServiceLevel">Service level</label><select name="ServiceLevel"><option>Standard</option><option>Express</option><option>Registered</option></select></div><div><label for="LengthCm">Length (cm)</label><input name="LengthCm" type="number" min="1" value="20"/></div><div><label for="WidthCm">Width (cm)</label><input name="WidthCm" type="number" min="1" value="15"/></div><div><label for="HeightCm">Height (cm)</label><input name="HeightCm" type="number" min="1" value="10"/></div></div><button class="button button-primary" type="submit">Add shipping service</button></form></section> }
@if (Model.Status == TransactionStatus.Open) { <section class="panel form-panel"><p class="eyebrow">IDENTITY SERVICES</p><h2>Postal and financial services</h2><p class="muted">Add a money order or record an identity-verification outcome against this open transaction.</p><a class="button button-quiet" asp-controller="MoneyOrders" asp-action="Create" asp-route-transactionId="@Model.Id">＋ Add money order</a> <a class="button button-quiet" asp-controller="IdentityVerifications" asp-action="Create" asp-route-transactionId="@Model.Id">＋ Record identity verification</a></section> }
@if (Model.Status == TransactionStatus.Open) { <section class="panel form-panel"><p class="eyebrow">ADD TO BASKET</p><h2>Add a retail product</h2><form asp-action="AddRetail" method="post" class="form-row"><input type="hidden" name="TransactionId" value="@Model.Id" /><div><label for="Sku">SKU</label><input id="Sku" name="Sku" placeholder="APX-001" required /></div><div><label for="Quantity">Quantity</label><input id="Quantity" name="Quantity" type="number" min="1" max="1000" value="1" required /></div><button class="button button-primary" type="submit">Add item</button></form></section> }
