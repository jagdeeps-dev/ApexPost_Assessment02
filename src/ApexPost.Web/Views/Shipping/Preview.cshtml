@model ShippingViewModel
@{ ViewData["Title"] = "Shipping rate preview"; }
<div class="page-heading"><div><p class="eyebrow">POSTAL SERVICES</p><h1>Shipping label preview</h1><p class="muted">Estimate charges using the configured zone and service-level pricing strategy.</p></div></div>
<section class="panel form-panel narrow-panel"><form asp-action="Preview" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div><label asp-for="Kind">Shipment type</label><select asp-for="Kind" asp-items="Html.GetEnumSelectList<ShipmentKind>()"></select></div><div><label asp-for="ServiceLevel">Service level</label><select asp-for="ServiceLevel" asp-items="Html.GetEnumSelectList<ServiceLevel>()"></select></div><div><label asp-for="WeightKg">Weight (kg)</label><input asp-for="WeightKg" type="number" step="0.01" min="0.01" max="100" /><span asp-validation-for="WeightKg" class="validation"></span></div><div><label asp-for="DestinationZone">Destination zone</label><select asp-for="DestinationZone">@for (var i = 1; i <= 10; i++) { var zone = $"ZONE-{i:00}"; <option value="@zone">@zone</option> }</select></div><div><label asp-for="LengthCm">Length (cm)</label><input asp-for="LengthCm" type="number" min="1" /></div><div><label asp-for="WidthCm">Width (cm)</label><input asp-for="WidthCm" type="number" min="1" /></div><div><label asp-for="HeightCm">Height (cm)</label><input asp-for="HeightCm" type="number" min="1" /></div></div><button class="button button-primary" type="submit">Calculate rate</button></form></section>
