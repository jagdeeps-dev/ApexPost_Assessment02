@model BranchEditViewModel
@{ ViewData["Title"] = Model.Id is null ? "Add branch" : "Edit branch"; }
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>@ViewData["Title"]</h1></div></div>
<section class="panel form-panel narrow-panel"><form asp-action="@(Model.Id is null ? "Create" : "Edit")" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div><label asp-for="Code"></label><input asp-for="Code" readonly="@(Model.Id is not null)"/><span asp-validation-for="Code" class="validation"></span></div><div><label asp-for="Name"></label><input asp-for="Name"/></div><div><label asp-for="Region"></label><input asp-for="Region"/></div><div><label asp-for="OpeningHours"></label><input asp-for="OpeningHours" placeholder="09:00-17:00"/></div><div><label asp-for="Status"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<BranchStatus>()"></select></div><div><label asp-for="CounterName">Primary counter name</label><input asp-for="CounterName"/></div></div><button class="button button-primary" type="submit">Save branch</button> <a class="button button-quiet" asp-action="Index">Cancel</a></form></section>
