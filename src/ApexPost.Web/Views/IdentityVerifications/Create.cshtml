@model IdentityVerificationViewModel
@{ ViewData["Title"] = "Identity verification"; }
<div class="page-heading"><div><p class="eyebrow">IDENTITY SERVICES</p><h1>Record identity verification</h1><p class="muted">The full document number is used only in memory and is never persisted.</p></div></div>
<section class="panel form-panel narrow-panel"><form asp-action="Create" method="post"><input asp-for="TransactionId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div><label asp-for="DocumentType">Document type</label><select asp-for="DocumentType" asp-items="Html.GetEnumSelectList<IdentityDocumentType>()"></select></div><div><label asp-for="Result">Verification result</label><select asp-for="Result"><option value="Successful">Successful</option><option value="Failed">Failed</option></select></div><div class="span-two"><label asp-for="DocumentNumber">Document number</label><input asp-for="DocumentNumber" autocomplete="off" maxlength="100"/><span asp-validation-for="DocumentNumber" class="validation"></span><span class="fine-print">Only the masked form (last four characters) is saved.</span></div></div><button class="button button-primary" type="submit">Save verification result</button> <a class="button button-quiet" asp-controller="Transactions" asp-action="Details" asp-route-id="@Model.TransactionId">Cancel</a></form></section>
